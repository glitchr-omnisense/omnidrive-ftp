{
    "name": "omnidrive/ftp",
    "type": "library",
    "description": "Omnidrive FTP: a directory of an FTP or FTPS server as an omnidrive drive, through league/flysystem-ftp (ext-ftp) - passive mode, a server behind NAT, binary transfers, Unix modes.",
    "keywords": ["storage", "ftp", "ftps", "flysystem", "omnidrive"],
    "homepage": "https://github.com/glitchr-omnisense/omnidrive-ftp",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "ext-ftp": "*",
        "league/flysystem-ftp": "^3.0",
        "omnisense/omnidrive": "^1.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Omnidrive\\Ftp\\": ""},
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {"Omnidrive\\Ftp\\Tests\\": "Tests/"}
    },
    "config": {"sort-packages": true}
}
